# Copy to .env.local and replace every CHANGE_ME. .env.local is git-ignored.
POSTGRES_USER=moneyghosts
POSTGRES_PASSWORD=CHANGE_ME
MONGO_USER=moneyghosts
MONGO_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://moneyghosts:CHANGE_ME@localhost:5432/moneyghosts
MONGODB_URI=mongodb://moneyghosts:CHANGE_ME@localhost:27017/?authSource=admin
MONGODB_DB=moneyghosts
# Long random string, e.g. output of: openssl rand -hex 48
JWT_SECRET=CHANGE_ME
